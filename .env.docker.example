# Pin production to a SemVer tag or immutable digest. Do not use latest for rollback.
TMUXATLAS_IMAGE=ghcr.io/losfurina/tmuxatlas
TMUXATLAS_IMAGE_TAG=v0.9.5
# Keep "always" in production; CI/local image tests can use "never".
TMUXATLAS_PULL_POLICY=always

# Final browser-facing trusted HTTPS origin used by Passkeys and WebSockets.
TMUXATLAS_PUBLIC_URL=https://tmuxatlas.example.com

# Loopback origin consumed by Cloudflare Tunnel or Nginx on the host.
TMUXATLAS_ORIGIN_PORT=7654

# Idle browser login lifetime. Durable Passkeys survive container recreation.
TMUXATLAS_SESSION_TTL=168h

# Use a different volume name for each environment.
TMUXATLAS_VOLUME=tmuxatlas-data
