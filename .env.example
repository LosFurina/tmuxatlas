# Copy only the section for this machine's role to
# ~/.config/tmuxatlas/.env.

# Hub:
# Passkeys are bound to this exact browser-facing origin. Set the final URL
# before enrolling the first passkey.
TMUXATLAS_PUBLIC_URL=https://tmuxatlas.example.com

# Keep the plaintext origin on loopback when TLS terminates at Cloudflare
# Tunnel, Nginx, or another trusted gateway.
TMUXATLAS_LISTEN=127.0.0.1:7654

# Browser sessions expire after this much inactivity. Go duration syntax is
# supported, for example 24h, 168h (7 days), or 720h (30 days).
TMUXATLAS_SESSION_TTL=24h

# Agent (do not set TMUXATLAS_PUBLIC_URL on an Agent-only machine):
# TMUXATLAS_HUB=https://tmuxatlas.example.com
